# Copy to .env. The backend loads it; do not prefix server secrets with VITE_.
WORLDOS_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
WORLDOS_MAX_UPLOAD_MB=12
# V0.2: server-side credentials only. Never put keys in VITE_ variables.
# Create a Meta Model API key with model access and billing/credits.
MODEL_API_KEY=
WORLDOS_MUSE_MODEL=muse-spark-1.3
WORLDOS_MUSE_PROVIDER=auto
BASETEN_API_KEY=
# Auto prefers Baseten when its key is configured; otherwise uses Meta.
# Set meta or baseten explicitly to select one provider. Baseten transport failures
# may fall back once to Meta if MODEL_API_KEY is available; results disclose this.
BASETEN_MUSE_MODEL=meta-models/muse-spark-open-1026
BASETEN_BASE_URL=https://inference.baseten.co/v1
WORLDOS_AI_TIMEOUT_SECONDS=45

# Inspect SQLite data directory. Default: repository-local data/ (Git-ignored).
# Use a stable absolute path to keep the database across checkouts.
# WORLDOS_DATA_DIR=C:/WorldOSData
# Inspect demo uses the existing Meta SAM adapter. Access still needs a real key
# and explicit live validation; configuration alone is not a successful test.
WORLDOS_SAM_PROVIDER=meta
# Optional Baseten configuration remains blocked pending a verified deployment
# request/response contract. No payload is guessed or sent on that path.
BASETEN_SAM_MODEL_ID=
# This uses sam-3.1 at Meta's Responses API with MODEL_API_KEY.

# V0.7 access control. Local mode accepts unauthenticated loopback access only.
# Generate a passphrase hash in separate ignored .env.auth with:
# .\.venv\Scripts\python.exe scripts/create_login.py
# Do not paste passwords or provider keys into frontend VITE_ variables.
WORLDOS_DEPLOYMENT=local
WORLDOS_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# Public deployment requires the hash, HTTPS, exact hosts and explicit origins.
# Docker Compose in deploy/ supplies public settings and native CORS origins.
# VITE_API_BASE_URL is an optional non-secret HTTPS origin for separate hosting.
# Native releases require it in the build environment (see docs/V07_MOBILE.md).
# V0.8: same-origin browser sessions use HttpOnly cookies and persist in auth.sqlite3.
# Public deployments create daily workspace SQLite backups (7 retained snapshots).
# Render sets exact hosts/origins from its assigned hostname in backend.launch_render.
# Optional verified custom domain: WORLDOS_PUBLIC_URL=https://your-domain.example
# Never set RENDER=true or use Render's proxy trust settings on a directly exposed VM.
# Default Render Blueprint uses WORLDOS_STORAGE_MODE=ephemeral and /tmp/worldos.
# SQLite, photos, backups and sessions can disappear on restart/redeploy/spin-down.
# Free resource settings: 6 MB uploads, 6 MP images, 12 MB bodies, one active write.
# WORLDOS_MAX_IMAGE_PIXELS=24000000
# WORLDOS_MAX_REQUEST_MB=32
# WORLDOS_MAX_CONCURRENT_WRITES=2
# WORLDOS_STORAGE_MODE=persistent
# WORLDOS_BACKUPS_ENABLED=1
# Paid disk-backed option is separate: deploy/render.paid.yaml. Never use for $0 hosting.
# Optional V0.8 judge access is DISABLED unless both backend variables are configured.
# Generate a DIFFERENT demo passphrase using scripts/create_login.py --access judge
# --expires-at 2026-11-05T04:00:00Z (choose your own timezone-qualified deadline).
# The helper writes ignored .env.judge. In Render add the values manually:
# WORLDOS_JUDGE_PASSWORD_HASH=<generated PBKDF2 hash, never a frontend variable>
# WORLDOS_JUDGE_ACCESS_EXPIRES_AT=<ISO timestamp with timezone>
# Judge photos and trials are isolated in WORLDOS_DATA_DIR/judge-demo/worldos.sqlite3.
